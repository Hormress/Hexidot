<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="{{ config.language }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% if page.title %}{{ page.title }} - {% endif %}{{ config.title }}</title>
        {{ custom_styles() | safe }}
        {{ custom_scripts() | safe }}
    </head>
    <body id="html-body">
        <div id="skrollr-body">
            <div id="container-wrap-wrap">
                <div id="container-wrap">
                    <div id="container">
                        <div id="header">
                            <h1><a href="{{ config.url }}"><span>{{ config.title }}</span></a></h1>
                            <h2><span>{{ config.subtitle }}</span></h2>
                            {{ partial("_partial/nav_top.njk") | safe }}
                            <div id="search-top-box">{{ hexidot_search_form({class: '', button: __('search'), text: __('search_this_site')}) | safe }}</div>
                            <div id="login-status"></div>
                            <div id="header-extra-div-1"></div>
                            <div id="header-extra-div-2"></div>
                            <div id="header-extra-div-3"></div>
                        </div>
                        <div id="content-wrap">
                            {{ partial("_partial/nav_side.njk") | safe }}
                            <div id="main-content">
                                {{ body | safe }}
                            </div>
                        </div>
                        <div id="footer"></div>
                        <div id="license-area"></div>
                        <div id="extrac-div-1"></div>
                        <div id="extrac-div-2"></div>
                        <div id="extrac-div-3"></div>
                    </div>
                </div>
                <div id="extra-div-1"></div>
                <div id="extra-div-2"></div>
                <div id="extra-div-3"></div>
                <div id="extra-div-4"></div>
                <div id="extra-div-5"></div>
                <div id="extra-div-6"></div>
            </div>
        </div>
    </body>
</html>